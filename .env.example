# Plantilla de variables de entorno. Copia este archivo a `.env` y sustituye los placeholders.
# No incluyas valores reales en este archivo.

# Credenciales de despliegue en Cloudflare.
CLOUDFLARE_API_TOKEN={{CLOUDFLARE_API_TOKEN}}
CLOUDFLARE_ACCOUNT_ID={{CLOUDFLARE_ACCOUNT_ID}}

# Secreto compartido entre las Functions y el Worker de conversión.
INTERNAL_SHARED_SECRET={{INTERNAL_SHARED_SECRET}}

# Acceso a la variante con inicio de sesión.
# ADMIN_PASSWORD solo se usa para generar el hash; no se guarda en Cloudflare.
ADMIN_USER={{ADMIN_USER}}
ADMIN_PASSWORD={{ADMIN_PASSWORD}}
ADMIN_PASSWORD_HASH={{ADMIN_PASSWORD_HASH}}
ADMIN_PASSWORD_SALT={{ADMIN_PASSWORD_SALT}}
# Iteraciones de PBKDF2. Valor de referencia: 5.000.
ADMIN_PASSWORD_ITERATIONS=5000

# Opcional: solo si se activa la protección antiabuso con Turnstile.
TURNSTILE_SECRET_KEY={{TURNSTILE_SECRET_KEY}}
